# --------------------------------------------------------------------------
# Cloak — environment configuration
#
# Copy this file to `.env` (project root) and fill in your real values.
# `.env` is gitignored. Restart the server after changing anything here.
# --------------------------------------------------------------------------

# --- MongoDB ---------------------------------------------------------------
# Local mongod running on the default port:
MONGODB_URI=mongodb://localhost:27017

# Docker:
# MONGODB_URI=mongodb://localhost:27017
#
# MongoDB Atlas (free shared cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# With auth on a self-hosted instance:
# MONGODB_URI=mongodb://cloakUser:secret@localhost:27017/cloak?authSource=admin

# Database name (will be created on first write if it doesn't exist).
MONGODB_DB=cloak

# --- HTTP server -----------------------------------------------------------
# Port the Express server listens on.
PORT=4000

# Bind address. 0.0.0.0 listens on all interfaces; 127.0.0.1 for localhost only.
HOST=0.0.0.0

# --- Cloaking --------------------------------------------------------------
# Optional. When set, the dashboard builds `cloakedUrl` from this origin
# instead of using the incoming Host header. Useful behind reverse proxies
# or when the public domain differs from the internal one.
#
# Example for production:
# CLOAK_PUBLIC_ORIGIN=https://go.your-domain.com

# --- Dev only --------------------------------------------------------------
# Where the Vite dev server should proxy /api and /r requests to. Only used
# by `npm run dev:web`. Leave the default unless you change PORT above.
VITE_API_TARGET=http://localhost:4000
