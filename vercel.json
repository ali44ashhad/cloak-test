{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    { "src": "api/[...path].ts", "use": "@vercel/node" }
  ],
  "rewrites": [{ "source": "/r/:path*", "destination": "/api/r/:path*" }]
}

